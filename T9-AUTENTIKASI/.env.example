# Salin file ini menjadi .env lalu sesuaikan dengan MySQL di komputer kamu
# Tanpa password  : mysql://root@localhost:3306/pwl26_buku
# Dengan password : mysql://root:passwordku@localhost:3306/pwl26_buku
DATABASE_URL="mysql://root@localhost:3306/pwl26_buku"
PORT=3000

# Buat secret acak dengan perintah:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-byte"
